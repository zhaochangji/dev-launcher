{
  "_comment": "团队共享的启动模板。面板扫描/添加项目时按目录后缀自动匹配，套用 scenario（w2 代理场景）、端口、访问地址、组合启动步骤。占位符：{dir}=项目目录 {repoRoot}=最近 .git 祖先 {repoParent}=仓库父目录 {user}=当前用户名 {nvm:x.y.z}=nvm 该版本 bin 路径 {PATH}=系统 PATH。匹配规则：目录路径以 match 中的后缀结尾，最长后缀优先。",
  "templates": [
    {
      "id": "interactive",
      "name": "interactive · 互动内容世界 B 端",
      "match": ["/open-platform-fe/apps/interactive"],
      "scenario": "interactive",
      "port": 8088,
      "url": "https://open-platform.staging.kuaishou.com",
      "start": [{ "cmd": "pnpm", "args": ["dev"] }],
      "note": "走 w2 场景「互动内容平台」；来自团队模板。dev 自带 --open 会弹 localhost:8088，勿在该页登录，一律走 staging 域名"
    },
    {
      "id": "open-platform-fe",
      "name": "open-platform-fe · 开放平台主站子应用（乾坤联调，自动连带主应用）",
      "match": ["/open-platform-fe/apps/open-platform-fe"],
      "scenario": "open-micro",
      "port": 5173,
      "url": "https://open-platform.staging.kuaishou.com",
      "start": [
        {
          "cmd": "yarn", "args": ["client:platform"], "cwd": "{repoParent}/mini-app-admin",
          "env": { "NODE_OPTIONS": "--openssl-legacy-provider" }, "delayMs": 3000,
          "pkill": "apps/platform-frontend"
        },
        { "cmd": "pnpm", "args": ["dev"] }
      ],
      "note": "走 w2 场景「微应用开发 - open 域名」；自动连带 main 应用（mini-app-admin）；来自团队模板"
    },
    {
      "id": "open-platform-fe-root",
      "name": "open-platform-fe · 仓库根（等价 interactive）",
      "match": ["/open-platform-fe"],
      "scenario": "interactive",
      "port": 8088,
      "url": "https://open-platform.staging.kuaishou.com",
      "start": [{ "cmd": "pnpm", "args": ["dev:interactive"] }],
      "note": "仓库根入口，等价于启动 interactive；来自团队模板"
    },
    {
      "id": "platform-frontend",
      "name": "platform-frontend · 乾坤主应用容器",
      "match": ["/mini-app-admin/apps/platform-frontend", "/mini-app-admin"],
      "scenario": null,
      "port": 8082,
      "url": "https://localhost:8082",
      "start": [
        {
          "cmd": "yarn", "args": ["client:platform"], "cwd": "{repoRoot}",
          "env": { "NODE_OPTIONS": "--openssl-legacy-provider" }
        }
      ],
      "note": "quasar 自带 https，接口代理到 mp-portal.staging；老 webpack4 需 openssl-legacy；来自团队模板"
    },
    {
      "id": "kp-fiction-playlet",
      "name": "kp-fiction-playlet · 短剧小程序前端",
      "match": ["/kp-fiction-playlet/apps/kp-fiction-playlet"],
      "scenario": null,
      "port": 8000,
      "url": "https://kp-fiction-playlet-{user}.led.staging.kuaishou.com",
      "start": [
        { "cmd": "pnpm", "args": ["dev"], "pkill": "kp-fiction-playlet/apps/kp-fiction-playlet" },
        { "cmd": "led", "args": ["start"], "delayMs": 4000, "pkill": "led start" }
      ],
      "note": "vite + led 隧道组合启动；led 域名按当前用户名生成；来自团队模板"
    },
    {
      "id": "gp-open-platform",
      "name": "general-project · open-platform",
      "match": ["/general-project/apps/open-platform"],
      "scenario": "general-open",
      "port": 8080,
      "url": "https://open-platform.staging.kuaishou.com",
      "start": [{ "cmd": "npm", "args": ["run", "dev"] }],
      "note": "走 w2 场景「general-project open-platform」；来自团队模板"
    },
    {
      "id": "oa-main",
      "name": "open-authorization · 主应用",
      "match": ["/open-authorization/apps/open-authorization"],
      "scenario": null,
      "start": [
        {
          "cmd": "pnpm", "args": ["dev"],
          "env": { "PATH": "{nvm:18.20.4}:{PATH}" }
        }
      ],
      "note": "engines 要求 node 18.20.4，自动注入 nvm 版本；来自团队模板"
    },
    {
      "id": "oa-h5",
      "name": "open-authorization · H5",
      "match": ["/open-authorization/apps/open-authorization-h5"],
      "scenario": null,
      "start": [
        {
          "cmd": "pnpm", "args": ["dev"],
          "env": { "PATH": "{nvm:18.20.4}:{PATH}" }
        }
      ],
      "note": "engines 要求 node 18.20.4，自动注入 nvm 版本；来自团队模板"
    },
    {
      "id": "oa-pc",
      "name": "open-authorization · PC",
      "match": ["/open-authorization/apps/open-authorization-pc"],
      "scenario": null,
      "start": [
        {
          "cmd": "pnpm", "args": ["dev"],
          "env": { "PATH": "{nvm:18.20.4}:{PATH}" }
        }
      ],
      "note": "engines 要求 node 18.20.4，自动注入 nvm 版本；来自团队模板"
    },
    {
      "id": "football-web",
      "name": "football · 彩票前端",
      "match": ["/football"],
      "scenario": null,
      "port": 3000,
      "url": "http://localhost:3000",
      "start": [{ "cmd": "npm", "args": ["run", "dev"] }],
      "note": "React + vite :3000；来自团队模板"
    },
    {
      "id": "football-server",
      "name": "football · 彩票后端",
      "match": ["/football/server"],
      "scenario": null,
      "port": 4000,
      "url": "http://localhost:4000",
      "start": [{ "cmd": "npm", "args": ["run", "dev"] }],
      "note": "Node tsx watch 服务，端口 4000；来自团队模板"
    },
    {
      "id": "qzone-history",
      "name": "qzone-history · QQ 空间历史恢复",
      "match": ["/qzone-history"],
      "scenario": null,
      "port": 17890,
      "url": "http://127.0.0.1:17890",
      "start": [{ "cmd": "./qzone-history", "args": [], "pkill": "qzone-history" }],
      "note": "Go 编译好的本地二进制，Web GUI 扫码登录；来自团队模板"
    },
    {
      "id": "voc-tool-web",
      "name": "voc-tool · VOC 报告生成器",
      "match": ["/voc-tool"],
      "scenario": null,
      "port": 8787,
      "url": "http://localhost:8787",
      "start": [{ "cmd": "npm", "args": ["run", "web"] }],
      "note": "ASIN 输入→采集/分析/渲染；来自团队模板"
    },
    {
      "id": "wx-policy-h5",
      "name": "wx-app policy-app · uni-app H5",
      "match": ["/wx-app/policy-app"],
      "scenario": null,
      "start": [{ "cmd": "npm", "args": ["run", "dev:h5"] }],
      "note": "浏览器调试用；小程序请用微信开发者工具；来自团队模板"
    },
    {
      "id": "login-component",
      "name": "login-component · packages/login-component",
      "match": ["/general-project/packages/login-component"],
      "scenario": null,
      "start": [{ "cmd": "yarn", "args": ["run", "dev"] }],
      "note": "PC 端注册登录组件；来自团队模板"
    },
    {
      "id": "open-login-iframe-client",
      "name": "open-login-iframe-client · packages/open-login-iframe-client",
      "match": ["/general-project/packages/open-login-iframe-client"],
      "scenario": null,
      "start": [{ "cmd": "yarn", "args": ["run", "dev"] }],
      "note": "开放平台账号统一；来自团队模板"
    }
  ]
}
